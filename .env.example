# Ontos environment configuration
#
# Copy to `.env` (git-ignored) and fill in the values you actually need.
# Values are grouped by milestone so you only set what your target
# milestone requires. M0 needs almost nothing.
#
# Sovereignty rule: any variable marked [BRIDGE] sends data outside the
# customer VPC and is a temporary dev convenience. Production deploys
# resolve every [BRIDGE] to a customer-controlled endpoint (Ollama /
# Bedrock / Azure OpenAI / Vertex) or to Enclave Scribe once Scribe
# passes benchmarks.


# ────────────────────────────────────────────────────────────────
# M0 — running today
# ────────────────────────────────────────────────────────────────

# Required in prod. In dev (ONTOS_ENV != "prod") the runtime auto-defaults
# to a loud placeholder — do NOT ship that placeholder to a customer.
# In prod, derive this from KMS (or the customer's key vault) at boot.
ONTOS_AUDIT_SIGNING_KEY=dev-only-signing-key-do-not-use

# Set to "prod" to make the runtime refuse to boot without a real
# signing key. Anything else (or unset) is dev mode.
ONTOS_ENV=dev

# Where the MCP server binds. 127.0.0.1 for local dev; 0.0.0.0 in a
# container behind a reverse proxy.
ONTOS_LISTEN_HOST=127.0.0.1
ONTOS_LISTEN_PORT=8765

# Which storage backend to use. M0 only supports "networkx" (in-memory).
# M1 adds "neo4j"; M2 adds "kuzu" (LadybugDB) and "neptune".
ONTOS_STORAGE_BACKEND=networkx

# Where the audit chain persists. SQLite default is fine for dev.
# M2 swaps to Postgres for regulated deploys (6+ month retention).
ONTOS_AUDIT_DB_URL=sqlite+pysqlite:///./audit-logs/audit.sqlite

# Name of the env var the runtime reads for the signing key.
# You almost never need to change this — it exists so a deploy can
# rename the concrete env var (e.g. to match a k8s secret's key).
ONTOS_AUDIT_SIGNING_KEY_ENV=ONTOS_AUDIT_SIGNING_KEY

# Optional: path to a YAML/LinkML ontology file. If unset, the runtime
# runs schemaless (M0 default).
# ONTOS_ONTOLOGY_PATH=./docs/ontology/examples/fintech.yaml


# ────────────────────────────────────────────────────────────────
# M1 — Neo4j storage + first extraction wrappers
# ────────────────────────────────────────────────────────────────

# Neo4j — self-hosted, Aura, or in-VPC cluster the customer runs.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# LLM for extraction — pick exactly ONE of the three blocks below.

# Option A [BRIDGE]: OpenAI. Fastest to test; violates in-VPC promise.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Option B [BRIDGE]: Anthropic. Better structured extraction than OpenAI.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# Option C: Ollama (fully local, no key). This is the sovereignty-preserving
# path and the shape Scribe eventually replaces.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Embedding model. BGE-m3 runs locally via sentence-transformers.
# EMBEDDING_MODEL=BAAI/bge-m3

# When Enclave Scribe is ready and beats frontier benchmarks, these
# replace every extraction key above:
# SCRIBE_ENDPOINT=http://scribe.ontos.svc.cluster.local:9000
# SCRIBE_MODEL=scribe-v1


# ────────────────────────────────────────────────────────────────
# M2 — permission-aware traversal + persistent audit
# ────────────────────────────────────────────────────────────────

# OpenFGA (default authz backend). Self-host in-VPC, or point at
# openfga.dev's hosted plane for dev.
# FGA_API_URL=http://localhost:8080
# FGA_STORE_ID=
# FGA_API_TOKEN=

# Alternative: SpiceDB (Authzed). Pick one, not both.
# SPICEDB_ENDPOINT=localhost:50051
# SPICEDB_TOKEN=

# Postgres for the persistent hash-chained audit log (replaces the M0
# SQLite default). Regulated deploys must retain ≥6 months.
# ONTOS_AUDIT_DB_URL=postgresql+psycopg://ontos:changeme@postgres:5432/ontos_audit


# ────────────────────────────────────────────────────────────────
# M4 — real source connectors (per customer, per tenant, not global)
# ────────────────────────────────────────────────────────────────
#
# These are examples of what a connector config will look like — the
# real system will load per-tenant credentials from a secure store,
# not from process env. Do not put customer credentials here.
#
# SLACK_BOT_TOKEN=xoxb-...
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# CONFLUENCE_API_TOKEN=
# JIRA_API_TOKEN=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=
